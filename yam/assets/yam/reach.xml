<mujoco model="yam_reach">
  <!-- Minimal smoke-test task: drive the gripper to a randomized 3-D target.
       The target is a mocap body (no qpos), so nq = arm(8) only. Used to sanity
       check the model, IK, teleop, recording, and the viewer without needing
       contact-rich grasping to work first. -->
  <include file="yam.xml"/>

  <statistic center="0.3 0 0.2" extent="1.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="target_mat" rgba="0.2 0.8 0.3 0.6"/>
  </asset>

  <worldbody>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" pos="0 0 -0.01" contype="1" conaffinity="1"/>

    <body name="target" pos="0.4 0.0 0.3" mocap="true">
      <geom name="target_geom" type="sphere" size="0.03" material="target_mat" contype="0" conaffinity="0"/>
    </body>

    <camera name="front" pos="0.95 0 0.5" xyaxes="0 1 0 -0.6 0 0.8" fovy="58"/>
    <camera name="top" pos="0.35 0 0.9" xyaxes="1 0 0 0 1 0" fovy="55"/>
    <camera name="side" pos="0.35 0.95 0.45" xyaxes="-1 0 0 0 -0.5 0.85" fovy="58"/>
  </worldbody>
</mujoco>
