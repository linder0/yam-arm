<mujoco model="yam_bimanual_scene">
  <!-- Task scene for the TWO-ARM setup: table, floor, one cube + target per
       arm, cameras and materials. It deliberately contains NO arm: the two YAM
       arms are attached programmatically (yam.bimanual.build_model) with
       "left_"/"right_" name prefixes so a bimanual model has no name clashes.
       Kept separate from the single-arm scenes so the single-arm pipeline is
       untouched. meshdir stays "assets" for the arms attached later. -->
  <compiler angle="radian" meshdir="assets"/>

  <option integrator="implicitfast"/>

  <statistic center="0.3 0 0.15" extent="1.1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="tabletop" rgba="0.55 0.45 0.35 1"/>
    <material name="cube_l_mat" rgba="0.85 0.2 0.2 1"/>
    <material name="cube_r_mat" rgba="0.2 0.4 0.85 1"/>
    <material name="target_l_mat" rgba="0.2 0.8 0.3 0.35"/>
    <material name="target_r_mat" rgba="0.85 0.7 0.2 0.35"/>
  </asset>

  <worldbody>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" pos="0 0 -0.4" contype="1" conaffinity="1"/>

    <!-- Table: top surface at z = 0, so both arm bases sit on it. Wider in y to
         fit two arms side by side at the near edge. -->
    <geom name="table" type="box" material="tabletop" pos="0.3 0 -0.02" size="0.45 0.6 0.02"
      contype="1" conaffinity="1"/>

    <!-- Left arm's cube + place target. -->
    <body name="cube_l" pos="0.4 0.2 0.025">
      <freejoint name="cube_l_free"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="2.1e-5 2.1e-5 2.1e-5"/>
      <geom name="cube_l_geom" type="box" size="0.025 0.025 0.025" material="cube_l_mat"
        condim="4" friction="1.0 0.05 0.01" contype="1" conaffinity="1"/>
    </body>
    <body name="target_l" pos="0.32 0.34 0.001" mocap="true">
      <geom name="target_l_geom" type="cylinder" size="0.06 0.001" material="target_l_mat"
        contype="0" conaffinity="0"/>
    </body>

    <!-- Right arm's cube + place target. -->
    <body name="cube_r" pos="0.4 -0.2 0.025">
      <freejoint name="cube_r_free"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="2.1e-5 2.1e-5 2.1e-5"/>
      <geom name="cube_r_geom" type="box" size="0.025 0.025 0.025" material="cube_r_mat"
        condim="4" friction="1.0 0.05 0.01" contype="1" conaffinity="1"/>
    </body>
    <body name="target_r" pos="0.32 -0.34 0.001" mocap="true">
      <geom name="target_r_geom" type="cylinder" size="0.06 0.001" material="target_r_mat"
        contype="0" conaffinity="0"/>
    </body>

    <!-- Exterior cameras framing both arms. -->
    <camera name="front" pos="1.05 0 0.6" xyaxes="0 1 0 -0.6 0 0.8" fovy="62"/>
    <camera name="top" pos="0.35 0 0.95" xyaxes="1 0 0 0 1 0" fovy="60"/>
  </worldbody>
</mujoco>
